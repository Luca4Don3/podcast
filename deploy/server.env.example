# 复制为 server.env 后修改；不要提交真实密钥
APP_ENV=production
PUBLIC_BASE_URL=https://podcast.example.com

# 生成：openssl rand -base64 48
JWT_SECRET=<change-me-to-a-long-random-secret>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# 留空 = 开放注册；填写后注册必须带邀请码
SIGNUP_INVITE_CODE=

CORS_ALLOWED_ORIGINS=*
RSS_USER_AGENT=PodcastApp/1.0 (+https://podcast.example.com)

# ---- 外部目录（默认禁用；未设置、空串或空白均不请求外部服务）----
# 管理员仅在自行核实内容授权及中国大陆地区适用性后，填写兼容目录 URL。
# 手动 RSS/电台导入不受影响；不内置全球目录地址。
ITUNES_SEARCH_URL=
RADIO_BROWSER_URL=
