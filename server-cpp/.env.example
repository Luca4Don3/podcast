# ---- 服务基础 ----
APP_ADDR=:8080
APP_ENV=production

# SQLite 数据文件（默认 <APP_DATA_DIR>/podcast.db）
APP_DATA_DIR=./data
DATABASE_PATH=
PUBLIC_BASE_URL=https://podcast.example.com

# ---- 认证 ----
# 生产务必替换：openssl rand -base64 48
JWT_SECRET=change-me-please-32-bytes-minimum
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SIGNUP_INVITE_CODE=

# ---- 网络 ----
CORS_ALLOWED_ORIGINS=*
WORKER_THREADS=8

# ---- RSS 抓取 ----
RSS_USER_AGENT=PodcastApp/1.0 (+https://podcast.example.com)
RSS_MAX_BYTES=20971520
RSS_TIMEOUT=20

# ---- 外部目录（默认禁用；未设置、空串或空白均不请求外部服务）----
# 管理员仅在自行核实内容授权及中国大陆地区适用性后，填写兼容目录 URL。
# 手动 RSS/电台导入不受影响；不内置全球目录地址。
ITUNES_SEARCH_URL=
RADIO_BROWSER_URL=

# 可选：只读文件音源。为空时不启用，注册后用 /api/v1/me 查目标用户 ID。
FILE_MEDIA_OWNER_ID=
FILE_MEDIA_ROOT=
# 需要编译开关 PODCAST_ENABLE_WEBDAV=ON。只接受预配置 HTTPS 地址。
FILE_MEDIA_DAV_URL=
FILE_MEDIA_DAV_USER=
FILE_MEDIA_DAV_PASSWORD_FILE=
