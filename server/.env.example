# ---- 服务基础 ----
APP_ADDR=:8080
APP_ENV=production
PUBLIC_BASE_URL=https://podcast.example.com

# SQLite 数据文件目录（容器内建议挂载 /data）
APP_DATA_DIR=./data
# 也可直接给 DSN：file:/data/podcast.db?_pragma=busy_timeout(10000)
DATABASE_DSN=

# ---- 认证 ----
# 生产环境务必替换：openssl rand -base64 48
JWT_SECRET=change-me-please-32-bytes-minimum
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# 注册邀请码，留空表示开放注册
SIGNUP_INVITE_CODE=

# 允许跨域的来源，逗号分隔；* 表示全放开（仅调试用）
CORS_ALLOWED_ORIGINS=*

# ---- RSS 抓取 ----
RSS_USER_AGENT=PodcastApp/1.0 (+https://podcast.example.com)
RSS_MAX_BYTES=20971520
RSS_TIMEOUT=20s

# ---- 外部目录（默认禁用；未设置、空串或空白均不请求外部服务）----
# 管理员仅在自行核实内容授权及中国大陆地区适用性后，填写兼容目录 URL。
# 手动 RSS/电台导入不受影响；不内置全球目录地址。
ITUNES_SEARCH_URL=
RADIO_BROWSER_URL=
