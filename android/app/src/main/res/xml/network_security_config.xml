<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Public podcast sources may still be HTTP; HTTPS is recommended and can be
      enforced per source. System trust anchors remain authoritative; the bundled
      ISRG roots only extend trust to older Android devices whose system store
      predates Let's Encrypt's newer public roots. They do not disable hostname
      or chain validation.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
            <certificates src="@raw/isrg_root_ye" />
        </trust-anchors>
    </base-config>
</network-security-config>
