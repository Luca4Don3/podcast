<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      部分公开播客源只提供 http（内网 / 无域名），这里放开明文；
      建议优先使用 https，用户可为单个来源开启“仅允许 HTTPS”以禁止 http。
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
